# Convex deployment URL (set automatically via integration or manually)
NEXT_PUBLIC_CONVEX_URL=

# Deploy key for Production and Preview environments
# Create at https://dashboard.convex.dev/project/settings#production-deploy-keys
CONVEX_DEPLOY_KEY=

# Optional: dev-only identity fallback (skip auth wiring during local dev)
# DEV_AUTH_USER_ID=dev-user-1

# Optional: Anthropic API key for manager LLM decisions
# ANTHROPIC_API_KEY=

# Optional: Vapi webhook secret for secure webhook events
# VAPI_WEBHOOK_SECRET=

# Optional: Override the manager model (defaults to claude-3-5-haiku-latest)
# MORPHICFIELDS_MANAGER_MODEL=
